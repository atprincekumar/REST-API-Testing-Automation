{
  "info": {
    "name": "JSONPlaceholder API Testing Collection",
    "description": "Practice GET, POST, PUT and DELETE API requests with basic response assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ],
  "item": [
    {
      "name": "GET - Get all posts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response time under 5 seconds\", function () { pm.expect(pm.response.responseTime).to.be.below(5000); });",
              "pm.test(\"Response is a non-empty array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/posts"
      },
      "response": []
    },
    {
      "name": "GET - Get post by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response time under 5 seconds\", function () { pm.expect(pm.response.responseTime).to.be.below(5000); });",
              "pm.test(\"Post ID is 1\", function () { pm.expect(pm.response.json().id).to.eql(1); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/posts/1"
      },
      "response": []
    },
    {
      "name": "GET - Unknown post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"Response time under 5 seconds\", function () { pm.expect(pm.response.responseTime).to.be.below(5000); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/posts/999999"
      },
      "response": []
    },
    {
      "name": "POST - Create post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Response time under 5 seconds\", function () { pm.expect(pm.response.responseTime).to.be.below(5000); });",
              "pm.test(\"Title is returned\", function () { pm.expect(pm.response.json().title).to.eql(\"API automation test\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/posts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"API automation test\",\n  \"body\": \"Created using Postman\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "PUT - Update post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response time under 5 seconds\", function () { pm.expect(pm.response.responseTime).to.be.below(5000); });",
              "pm.test(\"Updated title is returned\", function () { pm.expect(pm.response.json().title).to.eql(\"Updated API test title\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/posts/1",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Updated API test title\",\n  \"body\": \"Updated using Postman\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "DELETE - Delete post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response time under 5 seconds\", function () { pm.expect(pm.response.responseTime).to.be.below(5000); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/posts/1"
      },
      "response": []
    }
  ]
}